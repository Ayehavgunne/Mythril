src = src
out = out

setup:
    uv venv --clear
    uv sync --all-extras

lex:
    {_activate}
    python src/lexer.py

parse:
    {_activate}
	python {src}/parser.py

validate:
    {_activate}
	python {src}/validator.py

build:
    {_activate}
	mkdir -p {out} && python {src}/main.py test.my -o {out}/test -p --optimization=fast --ignore_warnings

run:
    {out}/test

fmt:
	{_activate}
	ruff format .

lint:
    {_activate}
	@if {$1} == fix
		ruff check --fix .
	@else
		ruff check .
	@fi

check:
    {_activate}
    @if {$1} == ""
		pyright .
    @else
		pyright {$1}
    @fi

benchmark:
    hyperfine -N --warmup 3 --runs 30 "out/test" "python test.py"

_activate:
	. .venv/bin/activate
