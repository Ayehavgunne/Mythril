src = src
out = out

setup:
    uv venv --clear
    uv sync --all-extras

lex:
    {_activate}
    python src/lexer.py

parse:
    {_activate}
	python {src}/parser.py

validate:
    {_activate}
	python {src}/validator.py

build:
    {_activate}
	@if {$1} in ["preview", "p"]
		echo Program:
		mkdir -p {out} && python {src}/main.py test.my -o {out}/test -p
	@else
		mkdir -p {out} && python {src}/main.py test.my -o {out}/test
	@fi

run:
    {out}/test

fmt:
	{_activate}
	ruff format .

lint:
    {_activate}
	@if {$1} == fix
		ruff check --fix .
	@else
		ruff check .
	@fi

check:
    {_activate}
    @if {$1} == ""
		pyright .
    @else
		pyright {$1}
    @fi

_activate:
	. .venv/bin/activate
