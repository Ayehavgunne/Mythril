enum Color[Str]
	GREEN
	RED
	BLUE
	YELLOW

struct Circle
	radius: Int
	x: Int
	y: Int

cir: Circle = {radius=5, x=2, y=4}

print(cir.radius)

abstract class Vehicle
	# Constructor
	new(make: Str, year: Int, color: Color)
		self.year = year
		self.make # Automtically assigns make from argument if they have the same name
		self._color = color
		self._fav_color: Color

# Inheritance. Only single inheritance allowed
class Car(Vehicle)
	new(make: Str, year: Int, color='green', hatchback=false)
		# Design by Contract
		require year < 10
		self.hatchback
		super(make, year, color)

	def print_year() > void
		print('This car was made in {self.year}')

class Person
	new(name: Str, age: Int)
