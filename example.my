				# Function Return notation
def fib(n: Int) > Int
	a = 0
	b = 1
	for _ in 0..n
		prev_a = a
		a = b
		b = prev_a + b
	return a

def fib_rec(n: Int) > Int
	if n == 0
		return 0
	if n == 1
		return 1
	return fib_rec(n - 1) + fib_rec(n - 2)

def factorial(n: Int) > Int {
	if n <= 1
		return 1
	return n * factorial(n - 1)

# Assign anonymous function to a variable
